<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Radios, espaciado (base 8) y medidas de docs/DESIGN.md.
    Las vistas toman de aquí todos sus tamaños; no se escriben números en Views/*.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Radios -->
    <CornerRadius x:Key="RadiusButton">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">24</CornerRadius>
    <CornerRadius x:Key="RadiusCardLg">32</CornerRadius>
    <CornerRadius x:Key="RadiusCardXl">64</CornerRadius>
    <!-- Decisión del proyecto (CLAUDE.md): etiquetas rectangulares, no pastillas como en DESIGN.md -->
    <CornerRadius x:Key="RadiusTag">8</CornerRadius>
    <CornerRadius x:Key="RadiusNavPill">48</CornerRadius>
    <!-- Solo esquinas superiores: la tarjeta "emerge" desde abajo -->
    <CornerRadius x:Key="RadiusTopArc">64,64,0,0</CornerRadius>

    <!-- Espaciado (StackPanel.Spacing, Grid.RowSpacing/ColumnSpacing) -->
    <x:Double x:Key="Spacing8">8</x:Double>
    <x:Double x:Key="Spacing16">16</x:Double>
    <x:Double x:Key="Spacing24">24</x:Double>
    <x:Double x:Key="Spacing40">40</x:Double>
    <x:Double x:Key="Spacing64">64</x:Double>
    <x:Double x:Key="Spacing80">80</x:Double>
    <x:Double x:Key="Spacing96">96</x:Double>

    <!-- Rellenos -->
    <Thickness x:Key="CardPadding">24</Thickness>
    <Thickness x:Key="PagePadding">40</Thickness>
    <Thickness x:Key="TagPadding">16,8</Thickness>
    <Thickness x:Key="NavPillPadding">24,0</Thickness>
    <Thickness x:Key="PrimaryButtonPadding">24,16</Thickness>
    <Thickness x:Key="GhostButtonPadding">16,16</Thickness>
    <Thickness x:Key="TextLinkButtonPadding">0,8</Thickness>
    <Thickness x:Key="InputPadding">16,8</Thickness>
    <Thickness x:Key="HairlineRowPadding">0,16</Thickness>
    <Thickness x:Key="TitleBarPadding">16,0</Thickness>

    <!-- Bordes -->
    <Thickness x:Key="HairlineThickness">0,0,0,1</Thickness>
    <Thickness x:Key="HairlineTopThickness">0,1,0,0</Thickness>
    <Thickness x:Key="InputBorderThickness">1</Thickness>
    <Thickness x:Key="GhostBorderThickness">1.5</Thickness>
    <Thickness x:Key="SwatchBorderThickness">1</Thickness>
    <Thickness x:Key="NoBorderThickness">0</Thickness>
    <Thickness x:Key="FocusVisualMargin">-3</Thickness>

    <!-- Medidas -->
    <x:Double x:Key="NavBarHeight">88</x:Double>
    <x:Double x:Key="TitleBarHeight">32</x:Double>
    <x:Double x:Key="ContentMaxWidth">1200</x:Double>
    <x:Double x:Key="WindowMinWidth">1100</x:Double>
    <x:Double x:Key="WindowMinHeight">700</x:Double>
    <x:Double x:Key="HairlineHeight">1</x:Double>
    <x:Double x:Key="SwatchWidth">168</x:Double>
    <x:Double x:Key="SwatchHeight">96</x:Double>
    <x:Double x:Key="GalleryLabelColumnWidth">280</x:Double>
</ResourceDictionary>
