<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Radios, espaciado (base 8) y medidas de docs/DESIGN.md.
    Las vistas toman de aquí todos sus tamaños; no se escriben números en Views/*.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Radios -->
    <CornerRadius x:Key="RadiusButton">8</CornerRadius>
    <!-- Botón ghost sobre fondo negro de mockup-dashboard.html -->
    <CornerRadius x:Key="RadiusButtonSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusCard">24</CornerRadius>
    <CornerRadius x:Key="RadiusCardLg">32</CornerRadius>
    <CornerRadius x:Key="RadiusCardXl">64</CornerRadius>
    <!-- Decisión del proyecto (CLAUDE.md): etiquetas rectangulares, no pastillas como en DESIGN.md -->
    <CornerRadius x:Key="RadiusTag">8</CornerRadius>
    <CornerRadius x:Key="RadiusNavPill">48</CornerRadius>
    <!-- Solo esquinas superiores: la tarjeta "emerge" desde abajo -->
    <CornerRadius x:Key="RadiusTopArc">64,64,0,0</CornerRadius>

    <!-- Espaciado (StackPanel.Spacing, Grid.RowSpacing/ColumnSpacing) -->
    <x:Double x:Key="Spacing8">8</x:Double>
    <x:Double x:Key="Spacing16">16</x:Double>
    <x:Double x:Key="Spacing24">24</x:Double>
    <x:Double x:Key="Spacing40">40</x:Double>
    <x:Double x:Key="Spacing64">64</x:Double>
    <x:Double x:Key="Spacing80">80</x:Double>
    <x:Double x:Key="Spacing96">96</x:Double>
    <!-- mockup-dashboard.html: 72 entre secciones, 48 entre tarjeta y estado, 12 entre barras y en etiquetas -->
    <x:Double x:Key="Spacing12">12</x:Double>
    <x:Double x:Key="Spacing32">32</x:Double>
    <x:Double x:Key="Spacing48">48</x:Double>
    <x:Double x:Key="Spacing72">72</x:Double>

    <!-- Rellenos -->
    <Thickness x:Key="CardPadding">24</Thickness>
    <!-- Tarjetas grandes del Dashboard (mockup-dashboard.html: padding 32) -->
    <Thickness x:Key="CardPaddingLg">32</Thickness>
    <!-- Bloque de cierre top-arc (mockup-dashboard.html: 64 arriba, 40 a los lados y abajo) -->
    <Thickness x:Key="TopArcPadding">40,64,40,40</Thickness>
    <!-- Cuerpo del Dashboard (mockup-dashboard.html: main con padding 48 arriba y 24 a los lados) -->
    <Thickness x:Key="DashboardPadding">24,48,24,0</Thickness>
    <Thickness x:Key="CierreMargin">0,96,0,0</Thickness>
    <!-- Filas de estado sobre el lienzo: línea arriba, 16 arriba y 24 abajo -->
    <Thickness x:Key="EstadoRowPadding">0,16,0,24</Thickness>
    <Thickness x:Key="AlertDotMargin">0,4,0,0</Thickness>
    <Thickness x:Key="PagePadding">40</Thickness>
    <Thickness x:Key="TagPadding">16,8</Thickness>
    <!-- mockup-dashboard.html: nav con padding 8 alrededor de ítems de 40 de alto -->
    <Thickness x:Key="NavPillPadding">8</Thickness>
    <Thickness x:Key="NavItemContentMargin">20,0</Thickness>
    <Thickness x:Key="NavItemMargin">2,0</Thickness>
    <!-- "Nueva lectura" en ventanas de menos de 1200 -->
    <Thickness x:Key="PrimaryButtonCompactPadding">16,16</Thickness>
    <Thickness x:Key="HeaderPadding">40,0</Thickness>
    <Thickness x:Key="FooterBarPadding">0,24,0,0</Thickness>
    <!--
        Separación de la cabecera y la barra inferior del onboarding como márgenes (no RowSpacing):
        en Bienvenida y Listo están ocultas y así no consumen alto que necesita la escena 3D.
    -->
    <Thickness x:Key="OnboardingHeaderMargin">0,0,0,24</Thickness>
    <Thickness x:Key="OnboardingFooterMargin">0,24,0,0</Thickness>
    <!--
        Con interlineado 0.9 los acentos de las mayúsculas (É, Í, Ñ) sobresalen del renglón; si el
        título es lo primero de un ScrollViewer, el viewport los recorta. Va como relleno del
        contenido (no del ScrollViewer, cuyo relleno queda fuera del área visible) y les deja lugar.
    -->
    <Thickness x:Key="ScrollAccentPadding">0,16,0,0</Thickness>
    <Thickness x:Key="PrimaryButtonPadding">24,16</Thickness>
    <Thickness x:Key="GhostButtonPadding">16,16</Thickness>
    <!-- 14,22 + borde de 1.5 = mismo alto que el botón primario (mockup-dashboard.html) -->
    <Thickness x:Key="GhostOnDarkButtonPadding">22,14</Thickness>
    <Thickness x:Key="TextLinkButtonPadding">0,8</Thickness>
    <Thickness x:Key="InputPadding">16,8</Thickness>
    <Thickness x:Key="HairlineRowPadding">0,16</Thickness>
    <Thickness x:Key="TitleBarPadding">16,0</Thickness>

    <!-- Bordes -->
    <Thickness x:Key="HairlineThickness">0,0,0,1</Thickness>
    <Thickness x:Key="HairlineTopThickness">0,1,0,0</Thickness>
    <Thickness x:Key="InputBorderThickness">1</Thickness>
    <Thickness x:Key="GhostBorderThickness">1.5</Thickness>
    <Thickness x:Key="SwatchBorderThickness">1</Thickness>
    <Thickness x:Key="NoBorderThickness">0</Thickness>
    <Thickness x:Key="FocusVisualMargin">-3</Thickness>
    <!-- Tarjetas seleccionables: borde transparente fijo para que el hover no mueva el contenido -->
    <Thickness x:Key="SelectionBorderThickness">2</Thickness>

    <!-- Medidas -->
    <x:Double x:Key="NavBarHeight">88</x:Double>
    <x:Double x:Key="TitleBarHeight">32</x:Double>
    <x:Double x:Key="ContentMaxWidth">1200</x:Double>
    <x:Double x:Key="WindowMinWidth">1100</x:Double>
    <x:Double x:Key="WindowMinHeight">700</x:Double>
    <x:Double x:Key="HairlineHeight">1</x:Double>
    <x:Double x:Key="SwatchWidth">168</x:Double>
    <x:Double x:Key="SwatchHeight">96</x:Double>
    <x:Double x:Key="GalleryLabelColumnWidth">280</x:Double>
    <!-- Ancho cómodo de lectura para párrafos y formularios -->
    <x:Double x:Key="TextMaxWidth">640</x:Double>
    <!-- Alto mínimo de la escena 3D de Bienvenida (cabe en la ventana mínima de 1100x700) -->
    <x:Double x:Key="EscenaMinHeight">360</x:Double>

    <!-- Gráficas del historial de Lecturas (LiveCharts2) -->
    <x:Double x:Key="GraficaAltura">280</x:Double>
    <x:Double x:Key="GraficaAnchoBarra">56</x:Double>
    <x:Double x:Key="GraficaGrosorLinea">2</x:Double>
    <x:Double x:Key="GraficaPunto">6</x:Double>
    <!-- Largo del trazo y del hueco de la recta punteada del presupuesto -->
    <x:Double x:Key="GraficaGuion">6</x:Double>
    <x:Double x:Key="SelectionCardMinHeight">160</x:Double>
    <x:Double x:Key="BrandIconSize">28</x:Double>
    <!-- Dashboard -->
    <x:Double x:Key="BreakpointWide">1200</x:Double>

    <!-- Escanear recibo: columna de la etiqueta de confianza (cabe "NO ENCONTRADO"), igual en todas las filas -->
    <GridLength x:Key="ColumnaEtiquetaConfianza">152</GridLength>

    <!-- Reparto entre inquilinos: anchos de los campos y columnas iguales en todas las filas -->
    <x:Double x:Key="CampoPeriodoMinWidth">360</x:Double>
    <x:Double x:Key="CampoMontoMinWidth">240</x:Double>
    <x:Double x:Key="CampoLecturaMinWidth">180</x:Double>
    <GridLength x:Key="ColumnaKwhReparto">120</GridLength>
    <GridLength x:Key="ColumnaCuotaReparto">140</GridLength>
    <x:Double x:Key="ChartHeight">240</x:Double>
    <x:Double x:Key="ChartBarMinWidth">40</x:Double>
    <x:Double x:Key="ProgressHeight">8</x:Double>
    <x:Double x:Key="HeroTextMaxWidth">440</x:Double>
    <!-- Flyout de "¿Qué es esto?": texto de 440 + relleno 2 × 24 + borde 2 × 1 = 490; WinUI lo limita a 456 si no se sube -->
    <x:Double x:Key="AyudaFlyoutMaxWidth">490</x:Double>
    <x:Double x:Key="InverseTextMaxWidth">340</x:Double>
    <x:Double x:Key="DotSize">10</x:Double>
    <x:Double x:Key="DotStrokeThickness">1.5</x:Double>
    <!-- Ítem seleccionado del nav: pastilla negra de 40 de alto -->
    <CornerRadius x:Key="RadiusNavItem">40</CornerRadius>
    <!-- Barra de progreso de 8: extremos redondos -->
    <CornerRadius x:Key="RadiusProgress">4</CornerRadius>
</ResourceDictionary>
