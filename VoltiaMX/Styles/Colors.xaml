            <SolidColorBrush x:Key="TemaGraphite" Color="#2F2F2F" />
            <SolidColorBrush x:Key="TemaMintChip" Color="#D1FFCA" />
            <SolidColorBrush x:Key="TemaTransparent" Color="Transparent" />

            <!-- Base -->
            <StaticResource x:Key="ApplicationPageBackgroundThemeBrush" ResourceKey="TemaWarmCanvas" />
            <StaticResource x:Key="TextFillColorPrimaryBrush" ResourceKey="TemaCarbonBlack" />
            <!-- Smoke no alcanza 4.5:1 como texto; el secundario y el terciario van en Slate -->
            <StaticResource x:Key="TextFillColorSecondaryBrush" ResourceKey="TemaSlate" />
            <StaticResource x:Key="TextFillColorTertiaryBrush" ResourceKey="TemaSlate" />
            <StaticResource x:Key="TextFillColorDisabledBrush" ResourceKey="TemaSmoke" />
