<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Paleta de docs/DESIGN.md y su traducción a los recursos de tema de WinUI.
    Solo se sobrescribe el tema Light (la app fija RequestedTheme="Light");
    HighContrast se deja intacto para que el alto contraste del sistema siga funcionando.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta -->
    <Color x:Key="CarbonBlackColor">#000000</Color>
    <Color x:Key="PaperWhiteColor">#FFFFFF</Color>
    <Color x:Key="WarmCanvasColor">#E5E5E5</Color>
    <Color x:Key="MistGrayColor">#F3F3F3</Color>
    <Color x:Key="AshColor">#C6C6C6</Color>
    <Color x:Key="SmokeColor">#979797</Color>
    <Color x:Key="SlateColor">#444444</Color>
    <Color x:Key="GraphiteColor">#2F2F2F</Color>
    <Color x:Key="MintChipColor">#D1FFCA</Color>
    <Color x:Key="VoltageYellowColor">#FFF100</Color>

    <SolidColorBrush x:Key="CarbonBlackBrush" Color="{StaticResource CarbonBlackColor}" />
    <SolidColorBrush x:Key="PaperWhiteBrush" Color="{StaticResource PaperWhiteColor}" />
    <SolidColorBrush x:Key="WarmCanvasBrush" Color="{StaticResource WarmCanvasColor}" />
    <SolidColorBrush x:Key="MistGrayBrush" Color="{StaticResource MistGrayColor}" />
    <SolidColorBrush x:Key="AshBrush" Color="{StaticResource AshColor}" />
    <SolidColorBrush x:Key="SmokeBrush" Color="{StaticResource SmokeColor}" />
    <SolidColorBrush x:Key="SlateBrush" Color="{StaticResource SlateColor}" />
    <SolidColorBrush x:Key="GraphiteBrush" Color="{StaticResource GraphiteColor}" />
    <SolidColorBrush x:Key="MintChipBrush" Color="{StaticResource MintChipColor}" />
    <SolidColorBrush x:Key="VoltageYellowBrush" Color="{StaticResource VoltageYellowColor}" />
    <SolidColorBrush x:Key="TransparenteBrush" Color="Transparent" />

    <!-- Acento del sistema: negro en lugar del azul de Windows -->
    <Color x:Key="SystemAccentColor">#000000</Color>
    <Color x:Key="SystemAccentColorLight1">#2F2F2F</Color>
    <Color x:Key="SystemAccentColorLight2">#444444</Color>
    <Color x:Key="SystemAccentColorLight3">#979797</Color>
    <Color x:Key="SystemAccentColorDark1">#000000</Color>
    <Color x:Key="SystemAccentColorDark2">#000000</Color>
    <Color x:Key="SystemAccentColorDark3">#000000</Color>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!--
                La paleta se repite aquí porque, dentro de un diccionario de tema, StaticResource
                solo es confiable hacia claves del mismo diccionario (igual que en generic.xaml).
                Se sobrescriben las brochas por clave de control: en WinUI son alias StaticResource
                ya resueltos, así que cambiar solo el acento o la brocha base no las alcanza.
            -->
