<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Escala tipográfica de docs/DESIGN.md.
    - Familias verificadas en la tabla "name" de cada TTF. Inter-Medium.ttf declara la familia
      "Inter" (WWS/tipográfica) y "Inter Medium" (GDI); se pone la segunda como respaldo.
    - Los estilos no fijan Foreground: el texto hereda el color de su contenedor
      (negro sobre el lienzo, blanco dentro de InvertedCardStyle).
    - LineHeight en px = interlineado × tamaño, con LineStackingStrategy=BlockLineHeight
      para que se respete aunque sea menor que la altura natural de la fuente.
    - CharacterSpacing va en milésimas de em: -0.03em = -30.
    - Los estilos display son para texto en MAYÚSCULAS: el texto ya viene así desde Resources.resw.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="DisplayFontFamily">ms-appx:///Assets/Fonts/BarlowCondensed-Bold.ttf#Barlow Condensed</FontFamily>
    <FontFamily x:Key="BodyFontFamily">ms-appx:///Assets/Fonts/Inter-Regular.ttf#Inter</FontFamily>
    <FontFamily x:Key="BodyMediumFontFamily">ms-appx:///Assets/Fonts/Inter-Medium.ttf#Inter, ms-appx:///Assets/Fonts/Inter-Medium.ttf#Inter Medium</FontFamily>
    <FontFamily x:Key="MonoFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>

    <!-- Fuente por defecto de los controles estándar (botones, cajas de texto, listas...) -->
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Inter-Regular.ttf#Inter</FontFamily>

    <x:Double x:Key="FontSizeDisplayXL">130</x:Double>
    <x:Double x:Key="FontSizeDisplay">80</x:Double>
    <x:Double x:Key="FontSizeHeadingLg">48</x:Double>
    <x:Double x:Key="FontSizeHeading">40</x:Double>
    <x:Double x:Key="FontSizeHeadingSm">28</x:Double>
    <x:Double x:Key="FontSizeSubheading">18</x:Double>
    <x:Double x:Key="FontSizeBody">16</x:Double>
    <x:Double x:Key="FontSizeBodySm">14</x:Double>
    <x:Double x:Key="FontSizeCaption">12</x:Double>

    <!-- Display: Barlow Condensed Bold, interlineado 0.9, -0.03em -->
    <Style x:Key="DisplayXLTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplayXL}" />
        <!-- 130 × 0.9 = 117 -->
        <Setter Property="LineHeight" Value="117" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="CharacterSpacing" Value="-30" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DisplayTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayXLTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <!-- 80 × 0.9 = 72 -->
        <Setter Property="LineHeight" Value="72" />
    </Style>

    <Style x:Key="HeadingLgTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayXLTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeadingLg}" />
        <!-- 48 × 0.9 = 43.2 -->
        <Setter Property="LineHeight" Value="43.2" />
    </Style>

    <!-- Encabezados: Inter Medium (el 450 de DESIGN.md cae entre 400 y 500; se usa 500) -->
    <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyMediumFontFamily}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
        <!-- 40 × 1.1 = 44 -->
        <Setter Property="LineHeight" Value="44" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <!-- -0.02em -->
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="HeadingSmTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HeadingTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeadingSm}" />
        <!-- 28 × 1.3 = 36.4 -->
        <Setter Property="LineHeight" Value="36.4" />
        <!-- DESIGN.md: -0.84px a 28px = -0.03em -->
        <Setter Property="CharacterSpacing" Value="-30" />
    </Style>

    <Style x:Key="SubheadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HeadingTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubheading}" />
        <!-- 18 × 1.33 = 23.94 ≈ 24 -->
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>

    <!-- Cuerpo: Inter Regular -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <!-- 16 × 1.25 = 20 -->
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodySmTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodySm}" />
        <!-- 14 × 1.3 = 18.2 -->
        <Setter Property="LineHeight" Value="18.2" />
        <!-- DESIGN.md: -0.154px a 14px = -0.011em -->
        <Setter Property="CharacterSpacing" Value="-11" />
    </Style>

    <!-- Etiquetas: JetBrains Mono -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <!-- 12 × 1.6 = 19.2 -->
        <Setter Property="LineHeight" Value="19.2" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <!-- DESIGN.md: -0.36px a 12px = -0.03em -->
        <Setter Property="CharacterSpacing" Value="-30" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
</ResourceDictionary>
