<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Metas sobre el lienzo: el campo del porcentaje, una sola tarjeta negra con el estado, los kWh al día
    y la única barra de progreso de la pantalla; el detalle y el historial en filas con línea.
-->
<Page
    x:Class="VoltiaMX.Views.MetasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:VoltiaMX.Helpers"
    xmlns:local="using:VoltiaMX.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:VoltiaMX.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid>
        <!-- Menos de 1200 de ancho: el detalle pasa debajo de la tarjeta -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AnchoVentana">
                <VisualState x:Name="Ancha">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource BreakpointWide}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Angosta">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ColumnaPrincipal.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ColumnaDetalle.(Grid.Row)" Value="1" />
                        <Setter Target="ColumnaDetalle.(Grid.Column)" Value="0" />
                        <Setter Target="ColumnaDetalle.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer>
            <StackPanel
                MaxWidth="{StaticResource ContentMaxWidth}"
                Padding="{StaticResource PagePadding}"
                Spacing="{StaticResource Spacing40}">

                <StackPanel Spacing="{StaticResource Spacing16}">
                    <TextBlock
                        x:Uid="Metas_Titulo"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource HeadingLgTextStyle}" />
                    <TextBlock
                        x:Uid="Metas_Explicacion"
                        Foreground="{StaticResource SlateBrush}"
                        Style="{StaticResource BodySmTextStyle}"
                        TextWrapping="Wrap" />
                    <local:AvisoDatosEjemplo Comando="{x:Bind ViewModel.IrAConfiguracionCommand}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.EsDemo), Mode=OneWay}" />
                    <local:AvisoPreciosDeEjemplo Comando="{x:Bind ViewModel.IrATarifasCommand}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.PreciosDeEjemplo), Mode=OneWay}" />
                </StackPanel>

                <!-- Crear la meta o cambiar el porcentaje; Enter guarda (ver MetasPage.xaml.cs) -->
                <StackPanel Spacing="{StaticResource Spacing24}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.MostrarFormulario), Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Spacing8}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.MostrarVacio), Mode=OneWay}">
                        <TextBlock x:Uid="Metas_VacioTitulo" Style="{StaticResource SubheadingLgTextStyle}" />
                        <TextBlock
                            x:Uid="Metas_VacioTexto"
                            Foreground="{StaticResource SlateBrush}"
                            Style="{StaticResource BodyTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <NumberBox
                        x:Uid="Metas_Porcentaje"
                        MaxWidth="{StaticResource TextMaxWidth}"
                        HorizontalAlignment="Left"
                        KeyUp="AlSoltarTeclaEnPorcentaje"
                        Style="{StaticResource NumberBoxStyle}"
                        Value="{x:Bind ViewModel.Porcentaje, Mode=TwoWay}" />
                    <Border Style="{StaticResource HairlineRowStyle}" Visibility="{x:Bind helpers:Conversiones.VisibleSiHayTexto(ViewModel.ErrorPorcentaje), Mode=OneWay}">
                        <Grid ColumnSpacing="{StaticResource Spacing16}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Uid="TarifaEditor_EtiquetaRevisa" VerticalAlignment="Center" Style="{StaticResource RiskHighTagStyle}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextStyle}"
                                Text="{x:Bind ViewModel.ErrorPorcentaje, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing24}">
                        <Button
                            x:Uid="Metas_Crear"
                            Command="{x:Bind ViewModel.GuardarCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.MostrarVacio), Mode=OneWay}" />
                        <Button
                            x:Uid="Metas_GuardarCambio"
                            Command="{x:Bind ViewModel.GuardarCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.MostrarEditor), Mode=OneWay}" />
                        <Button
                            x:Uid="Metas_CancelarCambio"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.CancelarCambioCommand}"
                            Style="{StaticResource TextLinkButtonStyle}"
                            Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.MostrarEditor), Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource BodyTextStyle}"
                    Text="{x:Bind ViewModel.Aviso, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind helpers:Conversiones.VisibleSiHayTexto(ViewModel.Aviso), Mode=OneWay}" />

                <!-- Con meta -->
                <StackPanel Spacing="{StaticResource Spacing40}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneMeta), Mode=OneWay}">
                    <Grid ColumnSpacing="{StaticResource Spacing48}" RowSpacing="{StaticResource Spacing32}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="ColumnaPrincipal" Spacing="{StaticResource Spacing16}">
                            <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="{x:Bind ViewModel.MetaTexto, Mode=OneWay}" TextWrapping="Wrap" />

                            <!-- La única tarjeta de la pantalla -->
                            <ContentPresenter Style="{StaticResource InvertedCardStyle}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.MostrarTarjeta), Mode=OneWay}">
                                <StackPanel Spacing="{StaticResource Spacing16}">
                                    <ContentPresenter
                                        HorizontalAlignment="Left"
                                        Content="{x:Bind ViewModel.EstadoEtiqueta, Mode=OneWay}"
                                        Style="{x:Bind helpers:Conversiones.EstiloEstadoMeta(ViewModel.Estado), Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource DisplayTextStyle}" Text="{x:Bind ViewModel.KwhPorDiaTexto, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{StaticResource AshBrush}"
                                        Style="{StaticResource BodyTextStyle}"
                                        Text="{x:Bind ViewModel.LeyendaKwhPorDia, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <ProgressBar
                                        x:Uid="Metas_Progreso"
                                        Style="{StaticResource ProgressOnDarkStyle}"
                                        Value="{x:Bind ViewModel.Progreso, Mode=OneWay}" />
                                    <TextBlock
                                        Foreground="{StaticResource AshBrush}"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="{x:Bind ViewModel.ProgresoTexto, Mode=OneWay}" />
                                </StackPanel>
                            </ContentPresenter>

                            <!-- Sin base o sin consumo medido -->
                            <StackPanel Spacing="{StaticResource Spacing8}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.MostrarSinDatos), Mode=OneWay}">
                                <TextBlock Style="{StaticResource SubheadingLgTextStyle}" Text="{x:Bind ViewModel.SinDatosTitulo, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{StaticResource SlateBrush}"
                                    Style="{StaticResource BodyTextStyle}"
                                    Text="{x:Bind ViewModel.SinDatosTexto, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Uid="Metas_IrALecturas"
                                    Command="{x:Bind ViewModel.IrALecturasCommand}"
                                    Style="{StaticResource TextLinkButtonStyle}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing24}" Visibility="{x:Bind helpers:Conversiones.VisibleSiNo(ViewModel.MostrarEditor), Mode=OneWay}">
                                <Button x:Uid="Metas_CambiarPorcentaje" Command="{x:Bind ViewModel.CambiarPorcentajeCommand}" Style="{StaticResource TextLinkButtonStyle}" />
                                <Button x:Uid="Metas_Desactivar" Command="{x:Bind ViewModel.DesactivarCommand}" Style="{StaticResource TextLinkButtonStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Detalle en filas con línea -->
                        <StackPanel x:Name="ColumnaDetalle" Grid.Column="1" Spacing="{StaticResource Spacing16}">
                            <Border Style="{StaticResource HairlineListStyle}">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Filas}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FilaDetalle">
                                            <Border Style="{StaticResource HairlineRowStyle}">
                                                <Grid ColumnSpacing="{StaticResource Spacing16}">
                                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" Text="{x:Bind Titulo}" />
                                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource SubheadingTextStyle}" Text="{x:Bind Detalle}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Border>
                            <TextBlock
                                Foreground="{StaticResource SlateBrush}"
                                Style="{StaticResource BodySmTextStyle}"
                                Text="{x:Bind ViewModel.AvisoBase, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind helpers:Conversiones.VisibleSiHayTexto(ViewModel.AvisoBase), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <!-- Historial -->
                    <StackPanel Spacing="{StaticResource Spacing16}">
                        <TextBlock
                            x:Uid="Metas_HistorialTitulo"
                            AutomationProperties.HeadingLevel="Level2"
                            Foreground="{StaticResource SlateBrush}"
                            Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock
                            x:Uid="Metas_HistorialVacio"
                            Foreground="{StaticResource SlateBrush}"
                            Style="{StaticResource BodyTextStyle}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind helpers:Conversiones.VisibleSiNo(ViewModel.TieneHistorial), Mode=OneWay}" />
                        <Border Style="{StaticResource HairlineListStyle}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneHistorial), Mode=OneWay}">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Historial}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FilaHistorialMetaVista">
                                        <Border Style="{StaticResource HairlineRowStyle}">
                                            <Grid ColumnSpacing="{StaticResource Spacing24}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" Text="{x:Bind Periodo}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SubheadingTextStyle}"
                                                    Text="{x:Bind Kwh}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource SlateBrush}"
                                                    Style="{StaticResource BodyTextStyle}"
                                                    Text="{x:Bind Reduccion}" />
                                                <ContentPresenter
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Content="{x:Bind Etiqueta}"
                                                    Style="{x:Bind helpers:Conversiones.EstiloCumplida(Cumplio)}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
