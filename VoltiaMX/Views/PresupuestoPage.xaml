<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Presupuesto sobre el lienzo: el campo del tope a la izquierda y una sola tarjeta negra con el
    presupuesto inverso; debajo, filas con línea y la única barra de progreso de la pantalla.
-->
<Page
    x:Class="VoltiaMX.Views.PresupuestoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:VoltiaMX.Helpers"
    xmlns:local="using:VoltiaMX.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid>
        <!-- Menos de 1200 de ancho: la tarjeta pasa debajo del campo -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AnchoVentana">
                <VisualState x:Name="Ancha">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource BreakpointWide}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Angosta">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Formulario.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="Resultado.(Grid.Row)" Value="1" />
                        <Setter Target="Resultado.(Grid.Column)" Value="0" />
                        <Setter Target="Resultado.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer>
            <StackPanel
                MaxWidth="{StaticResource ContentMaxWidth}"
                Padding="{StaticResource PagePadding}"
                Spacing="{StaticResource Spacing40}">

                <StackPanel Spacing="{StaticResource Spacing16}">
                    <TextBlock
                        x:Uid="Tope_Titulo"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource HeadingLgTextStyle}" />
                    <local:AvisoDatosEjemplo Comando="{x:Bind ViewModel.IrAConfiguracionCommand}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.EsDemo), Mode=OneWay}" />
                </StackPanel>

                <Grid ColumnSpacing="{StaticResource Spacing48}" RowSpacing="{StaticResource Spacing32}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Campo del tope; Enter guarda (ver PresupuestoPage.xaml.cs) -->
                    <StackPanel x:Name="Formulario" Spacing="{StaticResource Spacing24}">
                        <StackPanel Spacing="{StaticResource Spacing8}" Visibility="{x:Bind helpers:Conversiones.VisibleSiNo(ViewModel.TienePresupuesto), Mode=OneWay}">
                            <TextBlock x:Uid="Tope_VacioTitulo" Style="{StaticResource SubheadingLgTextStyle}" />
                            <TextBlock
                                x:Uid="Tope_VacioTexto"
                                Foreground="{StaticResource SlateBrush}"
                                Style="{StaticResource BodyTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <NumberBox
                            x:Uid="Tope_Monto"
                            Header="{x:Bind ViewModel.EtiquetaMonto, Mode=OneWay}"
                            KeyUp="AlSoltarTeclaEnMonto"
                            Style="{StaticResource NumberBoxStyle}"
                            Value="{x:Bind ViewModel.Monto, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing24}">
                            <Button
                                x:Uid="Tope_Guardar"
                                Command="{x:Bind ViewModel.GuardarCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                            <Button
                                x:Uid="Tope_Quitar"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.QuitarCommand}"
                                Style="{StaticResource TextLinkButtonStyle}"
                                Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TienePresupuesto), Mode=OneWay}" />
                        </StackPanel>
                        <!-- Aviso breve tras guardar o quitar; el lector de pantalla lo anuncia -->
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource BodyTextStyle}"
                            Text="{x:Bind ViewModel.Aviso, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind helpers:Conversiones.VisibleSiHayTexto(ViewModel.Aviso), Mode=OneWay}" />
                    </StackPanel>

                    <!-- La única tarjeta de la pantalla -->
                    <ContentPresenter
                        x:Name="Resultado"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Style="{StaticResource InvertedCardStyle}"
                        Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TienePresupuesto), Mode=OneWay}">
                        <StackPanel Spacing="{StaticResource Spacing16}">
                            <ContentPresenter x:Uid="Tope_Etiqueta" HorizontalAlignment="Left" Style="{StaticResource MintTagStyle}" />
                            <TextBlock Style="{StaticResource DisplayTextStyle}" Text="{x:Bind ViewModel.KwhPorDiaTexto, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource AshBrush}"
                                Style="{StaticResource BodyTextStyle}"
                                Text="{x:Bind ViewModel.TextoInverso, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Border Style="{StaticResource HairlineRowOnDarkStyle}">
                                <StackPanel Spacing="{StaticResource Spacing8}">
                                    <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="{x:Bind ViewModel.KwhRestantesTexto, Mode=OneWay}" />
                                    <TextBlock
                                        Foreground="{StaticResource AshBrush}"
                                        Style="{StaticResource BodySmTextStyle}"
                                        Text="{x:Bind ViewModel.RitmoTexto, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneRitmo), Mode=OneWay}" />
                                    <TextBlock
                                        Style="{StaticResource BodySmTextStyle}"
                                        Text="{x:Bind ViewModel.DiferenciaTexto, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneRitmo), Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ContentPresenter>
                </Grid>

                <!-- Detalle en filas con línea -->
                <StackPanel Spacing="{StaticResource Spacing16}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TienePresupuesto), Mode=OneWay}">
                    <StackPanel Spacing="{StaticResource Spacing8}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneConsumo), Mode=OneWay}">
                        <ProgressBar
                            x:Uid="Tope_Progreso"
                            Style="{StaticResource ProgressStyle}"
                            Value="{x:Bind ViewModel.ProgresoConsumo, Mode=OneWay}" />
                        <TextBlock Foreground="{StaticResource SlateBrush}" Style="{StaticResource CaptionTextStyle}" Text="{x:Bind ViewModel.ProgresoTexto, Mode=OneWay}" />
                    </StackPanel>

                    <Border Style="{StaticResource HairlineListStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource HairlineRowStyle}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.NoCubreCargoFijo), Mode=OneWay}">
                                <Grid ColumnSpacing="{StaticResource Spacing24}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="Tope_NoCubreCargoFijo" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                    <ContentPresenter x:Uid="Tope_EtiquetaRevisa" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource RiskHighTagStyle}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource HairlineRowStyle}">
                                <Grid ColumnSpacing="{StaticResource Spacing24}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="Tope_KwhMaximos" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SubheadingTextStyle}" Text="{x:Bind ViewModel.KwhMaximosTexto, Mode=OneWay}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource HairlineRowStyle}">
                                <StackPanel Spacing="{StaticResource Spacing8}">
                                    <TextBlock x:Uid="Tope_ProyeccionTitulo" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock
                                        Foreground="{StaticResource SlateBrush}"
                                        Style="{StaticResource BodySmTextStyle}"
                                        Text="{x:Bind ViewModel.ProyeccionTexto, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HairlineRowStyle}">
                                <TextBlock
                                    x:Uid="Tope_SinIvaNiDap"
                                    Foreground="{StaticResource SlateBrush}"
                                    Style="{StaticResource CaptionTextStyle}"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
