<?xml version="1.0" encoding="UTF-8" ?>
<Window
    x:Class="VoltiaMX.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título integrada; los botones del sistema se dibujan a la derecha -->
        <Grid
            x:Name="BarraTitulo"
            Height="{StaticResource TitleBarHeight}"
            Padding="{StaticResource TitleBarPadding}">
            <TextBlock
                x:Uid="Ventana_Marca"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextStyle}" />
        </Grid>

        <Frame x:Name="Contenido" x:FieldModifier="internal" Grid.Row="1" />
    </Grid>
</Window>
