<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Configuración (antes Más; la clase conserva el nombre): ajustes en filas con línea sobre el lienzo, cada una
    con un título y una línea de descripción, y con el modo avanzado las herramientas avanzadas. Sin tarjetas.
-->
<Page
    x:Class="VoltiaMX.Views.MasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:VoltiaMX.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:VoltiaMX.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer>
        <!-- Contenido centrado con ancho máximo (Styles/Controls.xaml, PageContentHostStyle) -->
        <helpers:PanelCentrado Style="{StaticResource PageContentHostStyle}">
            <StackPanel
                Padding="{StaticResource PagePadding}"
                Spacing="{StaticResource Spacing40}">
                <TextBlock
                    x:Uid="Mas_Titulo"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource DisplayTextStyle}" />

                <!-- Fase 9a (D3): solo estas filas, en este orden -->
                <Border Style="{StaticResource HairlineListStyle}">
                    <StackPanel>
                        <!-- Tu tarifa -->
                        <Border Style="{StaticResource HairlineRowStyle}">
                            <Grid ColumnSpacing="{StaticResource Spacing24}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource Spacing8}">
                                    <TextBlock x:Uid="Config_TarifasTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                    <TextBlock x:Uid="Mas_TarifasTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" />
                                </StackPanel>
                                <Button
                                    x:Uid="Config_TarifasBoton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.AbrirTarifasCommand}"
                                    Style="{StaticResource TextLinkButtonStyle}" />
                            </Grid>
                        </Border>


                        <!-- Avisos (notificaciones de Windows) -->
                        <Border Style="{StaticResource HairlineRowStyle}">
                            <Grid ColumnSpacing="{StaticResource Spacing24}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource Spacing8}">
                                    <TextBlock x:Name="TituloNotificaciones" x:Uid="Config_NotificacionesTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                    <TextBlock x:Uid="Mas_NotificacionesTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" />
                                    <TextBlock
                                        x:Uid="Config_NotificacionesNoDisponibles"
                                        Style="{StaticResource BodySmTextStyle}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.NotificacionesNoDisponibles)}" />
                                    <Button
                                        x:Uid="Config_NotificacionesPrueba"
                                        Command="{x:Bind ViewModel.EnviarPruebaCommand}"
                                        Style="{StaticResource TextLinkButtonSmStyle}"
                                        Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.NotificacionesDisponibles)}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Uid="Config_NotificacionesSwitch"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind TituloNotificaciones.Text}"
                                    IsOn="{x:Bind ViewModel.NotificacionesActivas, Mode=TwoWay}" />
                            </Grid>
                        </Border>


                        <!-- Respaldo y restauración -->
                        <Border Style="{StaticResource HairlineRowStyle}">
                            <Grid ColumnSpacing="{StaticResource Spacing24}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource Spacing8}">
                                    <TextBlock x:Uid="Config_RespaldoTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                    <TextBlock x:Uid="Mas_RespaldoTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" />
                                </StackPanel>
                                <Button
                                    x:Uid="Config_RespaldoBoton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.AbrirRespaldoCommand}"
                                    Style="{StaticResource TextLinkButtonStyle}" />
                            </Grid>
                        </Border>


                        <!-- Ayuda: qué significa cada palabra -->
                        <Border Style="{StaticResource HairlineRowStyle}">
                            <Grid ColumnSpacing="{StaticResource Spacing24}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource Spacing8}">
                                    <TextBlock x:Uid="Mas_AyudaTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                    <TextBlock x:Uid="Mas_AyudaTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Uid="Mas_AyudaBoton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.AbrirAyudaCommand}"
                                    Style="{StaticResource TextLinkButtonStyle}" />
                            </Grid>
                        </Border>


                        <!-- Datos de demostración -->
                        <Border Style="{StaticResource HairlineRowStyle}">
                            <Grid ColumnSpacing="{StaticResource Spacing24}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource Spacing8}">
                                    <TextBlock x:Uid="Mas_DemoTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                    <TextBlock x:Uid="Mas_DemoTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource Spacing16}">
                                    <Button x:Uid="Config_DemoCargar" Command="{x:Bind ViewModel.CargarDemoCommand}" Style="{StaticResource GhostButtonStyle}" />
                                    <Button x:Uid="Config_DemoQuitar" Command="{x:Bind ViewModel.QuitarDemoCommand}" Style="{StaticResource GhostButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>


                        <!-- Volver a contestar las preguntas iniciales (en la fase 9b llega el onboarding nuevo) -->
                        <Border Style="{StaticResource HairlineRowStyle}">
                            <Grid ColumnSpacing="{StaticResource Spacing24}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource Spacing8}">
                                    <TextBlock x:Uid="Config_OnboardingTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                    <TextBlock x:Uid="Mas_OnboardingTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" />
                                </StackPanel>
                                <Button
                                    x:Uid="Config_OnboardingBoton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.RepetirOnboardingCommand}"
                                    Style="{StaticResource GhostButtonStyle}" />
                            </Grid>
                        </Border>


                        <!-- Solo en compilaciones Debug (y fuera del modo presentación) -->
                        <Border Style="{StaticResource HairlineRowStyle}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.MostrarGaleria)}">
                            <Grid ColumnSpacing="{StaticResource Spacing24}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource Spacing8}">
                                    <TextBlock x:Uid="Config_GaleriaTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                    <TextBlock x:Uid="Config_GaleriaTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" />
                                </StackPanel>
                                <Button
                                    x:Uid="Config_GaleriaBoton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.AbrirGaleriaCommand}"
                                    Style="{StaticResource TextLinkButtonStyle}" />
                            </Grid>
                        </Border>


                        <!-- Modo avanzado: siempre la última fila antes de la versión (oculta en el modo presentación) -->
                        <Border Style="{StaticResource HairlineRowStyle}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.MostrarModoAvanzado)}">
                            <Grid ColumnSpacing="{StaticResource Spacing24}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource Spacing8}">
                                    <TextBlock x:Name="TituloModo" x:Uid="Config_ModoTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                    <TextBlock x:Uid="Mas_ModoTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Uid="Config_ModoSwitch"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind TituloModo.Text}"
                                    IsOn="{x:Bind ViewModel.ModoAvanzado, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Con el modo avanzado: herramientas que no son del día a día de una casa -->
                <StackPanel Spacing="{StaticResource Spacing16}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.MostrarHerramientas), Mode=OneWay}">
                    <TextBlock
                        x:Uid="Mas_HerramientasTitulo"
                        AutomationProperties.HeadingLevel="Level2"
                        Foreground="{StaticResource SlateBrush}"
                        Style="{StaticResource CaptionTextStyle}" />
                    <Border Style="{StaticResource HairlineListStyle}">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Herramientas}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilaMas">
                                    <Border Style="{StaticResource HairlineRowStyle}">
                                        <Grid ColumnSpacing="{StaticResource Spacing24}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="{StaticResource Spacing8}">
                                                <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="{x:Bind Titulo}" />
                                                <TextBlock Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" Text="{x:Bind Descripcion}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{x:Bind Titulo}"
                                                Command="{x:Bind Abrir}"
                                                Content="{x:Bind TextoBoton}"
                                                Style="{StaticResource TextLinkButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>

                <!-- Borrar mis datos y empezar de nuevo (D8): debajo de Modo avanzado y arriba de la versión -->
                <StackPanel Spacing="{StaticResource Spacing16}">
                    <Border Style="{StaticResource HairlineListStyle}">
                        <Border Style="{StaticResource HairlineRowStyle}">
                            <Grid ColumnSpacing="{StaticResource Spacing24}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource Spacing8}">
                                    <TextBlock x:Uid="Mas_BorrarTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                    <TextBlock x:Uid="Mas_BorrarTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Uid="Mas_BorrarBoton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.BorrarDatosCommand}"
                                    Style="{StaticResource GhostButtonStyle}" />
                            </Grid>
                        </Border>
                    </Border>
                    <TextBlock
                        AutomationProperties.LiveSetting="Assertive"
                        Style="{StaticResource BodyTextStyle}"
                        Text="{x:Bind ViewModel.ErrorBorrado, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind helpers:Conversiones.VisibleSiHayTexto(ViewModel.ErrorBorrado), Mode=OneWay}" />
                </StackPanel>

                <Border Style="{StaticResource HairlineListStyle}">
                    <!-- Versión: siempre al final, también en Release -->
                    <Border Style="{StaticResource HairlineRowStyle}">
                        <TextBlock x:Uid="Config_Version" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" />
                    </Border>
                </Border>
            </StackPanel>
        </helpers:PanelCentrado>
    </ScrollViewer>
</Page>
