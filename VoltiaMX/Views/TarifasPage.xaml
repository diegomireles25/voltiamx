<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Tarifas sobre el lienzo, sin tarjetas: la tarifa del lugar principal y la lista de tarifas en
    filas con línea, con sus enlaces.
-->
<Page
    x:Class="VoltiaMX.Views.TarifasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:VoltiaMX.Helpers"
    xmlns:local="using:VoltiaMX.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:VoltiaMX.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid>
    <!-- Menos de 1200 de ancho: en "Validar con tu recibo" el resultado pasa debajo de los campos -->
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="AnchoVentana">
            <VisualState x:Name="Ancha">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="{StaticResource BreakpointWide}" />
                </VisualState.StateTriggers>
            </VisualState>
            <VisualState x:Name="Angosta">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="0" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="CamposValidar.(Grid.ColumnSpan)" Value="2" />
                    <Setter Target="ResultadoValidar.(Grid.Row)" Value="1" />
                    <Setter Target="ResultadoValidar.(Grid.Column)" Value="0" />
                    <Setter Target="ResultadoValidar.(Grid.ColumnSpan)" Value="2" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <ScrollViewer>
        <!-- Contenido centrado con ancho máximo (Styles/Controls.xaml, PageContentHostStyle) -->
        <helpers:PanelCentrado Style="{StaticResource PageContentHostStyle}">
            <StackPanel
                x:Name="Contenido"
                Padding="{StaticResource PagePadding}"
                Spacing="{StaticResource Spacing40}">

                <StackPanel Spacing="{StaticResource Spacing16}">
                    <TextBlock
                        x:Uid="Tarifas_Titulo"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource HeadingLgTextStyle}" />
                    <TextBlock
                        x:Uid="Tarifas_SinIvaNiDap"
                        Foreground="{StaticResource SlateBrush}"
                        Style="{StaticResource BodySmTextStyle}"
                        TextWrapping="Wrap" />
                    <local:AvisoDatosEjemplo Comando="{x:Bind ViewModel.IrAConfiguracionCommand}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.EsDemo), Mode=OneWay}" />
                </StackPanel>

                <!-- Tarifa del lugar principal -->
                <StackPanel Spacing="{StaticResource Spacing16}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneLugar), Mode=OneWay}">
                    <TextBlock
                        x:Uid="Tarifas_DeTuLugar"
                        AutomationProperties.HeadingLevel="Level2"
                        Foreground="{StaticResource SlateBrush}"
                        Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="{x:Bind ViewModel.TarifaActualTexto, Mode=OneWay}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing16}">
                        <ComboBox
                            x:Uid="Tarifas_Elegir"
                            MinWidth="{StaticResource TextMaxWidth}"
                            ItemsSource="{x:Bind ViewModel.Opciones, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.TarifaElegida, Mode=TwoWay}"
                            Style="{StaticResource ComboBoxStyle}" />
                        <Button
                            x:Uid="Tarifas_Usar"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.UsarTarifaCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource BodyTextStyle}"
                        Text="{x:Bind ViewModel.Aviso, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind helpers:Conversiones.VisibleSiHayTexto(ViewModel.Aviso), Mode=OneWay}" />
                </StackPanel>

                <!-- Tus tarifas -->
                <StackPanel Spacing="{StaticResource Spacing16}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing16}">
                            <TextBlock
                                x:Uid="Tarifas_Tuyas"
                                VerticalAlignment="Center"
                                AutomationProperties.HeadingLevel="Level2"
                                Foreground="{StaticResource SlateBrush}"
                                Style="{StaticResource CaptionTextStyle}" />
                            <local:TerminoAyuda Clave="TramosDePrecio" />
                        </StackPanel>
                        <Button
                            x:Uid="Tarifas_Nueva"
                            HorizontalAlignment="Right"
                            Command="{x:Bind ViewModel.NuevaTarifaCommand}"
                            Style="{StaticResource GhostButtonStyle}" />
                    </Grid>
                    <Border Style="{StaticResource HairlineListStyle}">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Filas}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilaTarifa">
                                    <Border Style="{StaticResource HairlineRowStyle}">
                                        <Grid ColumnSpacing="{StaticResource Spacing24}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="{StaticResource Spacing8}">
                                                <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="{x:Bind Nombre}" />
                                                <TextBlock Foreground="{StaticResource SlateBrush}" Style="{StaticResource CaptionTextStyle}" Text="{x:Bind Detalle}" />
                                            </StackPanel>
                                            <ContentPresenter
                                                x:Uid="Tarifas_EnUso"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource MintTagStyle}"
                                                Visibility="{x:Bind helpers:Conversiones.VisibleSi(EnUso)}" />
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="{StaticResource Spacing16}">
                                                <Button x:Uid="Tarifas_Editar" Command="{x:Bind Editar}" Style="{StaticResource TextLinkButtonSmStyle}" />
                                                <Button x:Uid="Tarifas_Duplicar" Command="{x:Bind Duplicar}" Style="{StaticResource TextLinkButtonSmStyle}" />
                                                <Button x:Uid="Tarifas_Eliminar" Command="{x:Bind Eliminar}" Style="{StaticResource TextLinkButtonSmStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>

                <!-- Validar con tu recibo -->
                <StackPanel Spacing="{StaticResource Spacing16}">
                    <TextBlock
                        x:Uid="Validar_Titulo"
                        AutomationProperties.HeadingLevel="Level2"
                        Foreground="{StaticResource SlateBrush}"
                        Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock
                        x:Uid="Validar_Ayuda"
                        Foreground="{StaticResource SlateBrush}"
                        Style="{StaticResource BodySmTextStyle}"
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="{StaticResource Spacing48}" RowSpacing="{StaticResource Spacing32}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="CamposValidar" Spacing="{StaticResource Spacing24}">
                            <ComboBox
                                x:Uid="Validar_Tarifa"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.Opciones, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.TarifaValidar, Mode=TwoWay}"
                                Style="{StaticResource ComboBoxStyle}" />
                            <StackPanel Spacing="{StaticResource Spacing8}">
                                <TextBlock x:Uid="Validar_Periodo" Style="{StaticResource BodySmTextStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing24}">
                                    <RadioButton x:Uid="Validar_Bimestral" GroupName="PeriodoValidar" IsChecked="{x:Bind ViewModel.ValidarBimestral, Mode=TwoWay}" />
                                    <RadioButton x:Uid="Validar_Mensual" GroupName="PeriodoValidar" IsChecked="{x:Bind ViewModel.ValidarMensual, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                            <NumberBox x:Uid="Validar_Kwh" Style="{StaticResource NumberBoxStyle}" Value="{x:Bind ViewModel.KwhRecibo, Mode=TwoWay}" />
                            <NumberBox x:Uid="Validar_Importe" Style="{StaticResource NumberBoxStyle}" Value="{x:Bind ViewModel.ImporteRecibo, Mode=TwoWay}" />
                            <Button
                                x:Uid="Validar_Comparar"
                                Command="{x:Bind ViewModel.CompararCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>

                        <StackPanel
                            x:Name="ResultadoValidar"
                            Grid.Column="1"
                            Spacing="{StaticResource Spacing16}"
                            Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneComparacion), Mode=OneWay}">
                            <Grid ColumnSpacing="{StaticResource Spacing16}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    VerticalAlignment="Center"
                                    Content="{x:Bind ViewModel.VeredictoTexto, Mode=OneWay}"
                                    Style="{x:Bind helpers:Conversiones.EstiloVeredicto(ViewModel.Veredicto), Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextStyle}"
                                    Text="{x:Bind ViewModel.DiferenciaTexto, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <Border Style="{StaticResource HairlineListStyle}">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilasComparacion}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FilaRecibo">
                                            <Border Style="{StaticResource HairlineRowStyle}">
                                                <Grid ColumnSpacing="{StaticResource Spacing24}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{x:Bind helpers:Conversiones.EstiloFilaRecibo(EsTotal)}" Text="{x:Bind Concepto}" />
                                                    <TextBlock Grid.Column="1" Style="{x:Bind helpers:Conversiones.EstiloFilaRecibo(EsTotal)}" Text="{x:Bind Detalle}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Border>
                            <TextBlock
                                x:Uid="Validar_Sugerencia"
                                Style="{StaticResource BodySmTextStyle}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.NoCoincide), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <!-- Recalcular los periodos cerrados del lugar con su tarifa actual -->
                    <Border Style="{StaticResource HairlineRowStyle}">
                        <Grid ColumnSpacing="{StaticResource Spacing24}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="Recalcular_Explicacion"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource SlateBrush}"
                                Style="{StaticResource BodySmTextStyle}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Uid="Recalcular_Boton"
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.RecalcularCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </helpers:PanelCentrado>
    </ScrollViewer>
    </Grid>
</Page>
