<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Agregar un recibo por lo que se pagó (Fase 9c, D1): el mismo formulario en el onboarding (Tu recibo), en Inicio
    y en Mis recibos. Escribir cuánto pagaste o escanear el recibo (que solo prellena el total, la fecha de corte y la
    tarifa) y, en el primer recibo, cada cuánto llega. Siempre se puede revisar y cambiar lo escrito.
-->
<UserControl
    x:Class="VoltiaMX.Views.FormularioRecibo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:VoltiaMX.Helpers"
    xmlns:local="using:VoltiaMX.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="{StaticResource Spacing32}">
        <!-- Dos caminos; "Escribir cuánto pagué" va primero y preseleccionado -->
        <Grid ColumnSpacing="{StaticResource Spacing24}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton
                GroupName="CaminoRecibo"
                AutomationProperties.Name="{x:Bind TituloEscribir.Text}"
                IsChecked="{x:Bind ViewModel.ReciboPorMonto, Mode=TwoWay}"
                Style="{StaticResource SeleccionUnicaCardStyle}">
                <StackPanel Spacing="{StaticResource Spacing8}">
                    <TextBlock x:Name="TituloEscribir" x:Uid="OnboardingRecibo_EscribirTitulo" Style="{StaticResource HeadingSmTextStyle}" />
                    <TextBlock x:Uid="OnboardingRecibo_EscribirTexto" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
            <RadioButton
                Grid.Column="1"
                GroupName="CaminoRecibo"
                AutomationProperties.Name="{x:Bind TituloEscanear.Text}"
                IsChecked="{x:Bind ViewModel.ReciboEscanear, Mode=TwoWay}"
                Style="{StaticResource SeleccionUnicaCardStyle}">
                <StackPanel Spacing="{StaticResource Spacing8}">
                    <TextBlock x:Name="TituloEscanear" x:Uid="OnboardingRecibo_EscanearTitulo" Style="{StaticResource HeadingSmTextStyle}" />
                    <TextBlock x:Uid="OnboardingRecibo_EscanearTexto" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </RadioButton>
        </Grid>

        <!-- Escanear: elegir el archivo; lo leído llena los campos de abajo -->
        <StackPanel Spacing="{StaticResource Spacing16}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.MostrarEscanear), Mode=OneWay}">
            <Button
                x:Uid="OnboardingRecibo_ElegirArchivo"
                Command="{x:Bind ViewModel.ElegirReciboCommand}"
                Style="{StaticResource GhostButtonStyle}" />
            <ProgressRing
                x:Uid="OnboardingRecibo_Leyendo"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.Leyendo, Mode=OneWay}"
                Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.Leyendo), Mode=OneWay}" />
            <!-- Solo en Debug (ver FormularioRecibo.xaml.cs): ruta del archivo para pruebas automatizadas -->
            <StackPanel x:Name="ZonaRutaPrueba" Orientation="Horizontal" Spacing="{StaticResource Spacing16}" Visibility="Collapsed">
                <TextBox x:Name="CampoRutaPrueba" MinWidth="{StaticResource HeroTextMaxWidth}" />
                <Button x:Name="BotonRutaPrueba" VerticalAlignment="Bottom" Style="{StaticResource GhostButtonStyle}" />
            </StackPanel>
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource BodyTextStyle}"
                Text="{x:Bind ViewModel.AvisoEscaneo, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind helpers:Conversiones.VisibleSiHayTexto(ViewModel.AvisoEscaneo), Mode=OneWay}" />
        </StackPanel>

        <Grid ColumnSpacing="{StaticResource Spacing24}" RowSpacing="{StaticResource Spacing8}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <NumberBox
                x:Uid="OnboardingRecibo_Total"
                Style="{StaticResource NumberBoxStyle}"
                Value="{x:Bind ViewModel.TotalPagado, Mode=TwoWay}" />
            <CalendarDatePicker
                x:Uid="OnboardingRecibo_Fecha"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Date="{x:Bind ViewModel.FechaCorte, Mode=TwoWay}"
                Language="es-MX"
                MaxDate="{x:Bind ViewModel.FechaMaxima}"
                Style="{StaticResource DatePickerStyle}" />

            <!-- Fase 9k (D9): confianza del importe leído -->
            <ContentPresenter
                Grid.Row="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Content="{x:Bind ViewModel.EstadoImporte.Texto, Mode=OneWay}"
                Style="{x:Bind helpers:Conversiones.EstiloConfianza(ViewModel.EstadoImporte.Confianza), Mode=OneWay}"
                Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.Leido), Mode=OneWay}" />

            <!-- Qué fecha es (el final de "Periodo facturado") y, si se leyó, de dónde salió -->
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{StaticResource Spacing8}">
                <local:TerminoAyuda Clave="FinDelPeriodo" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="{StaticResource Spacing8}"
                    Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.Leido), Mode=OneWay}">
                    <ContentPresenter
                        VerticalAlignment="Center"
                        Content="{x:Bind ViewModel.EstadoFecha.Texto, Mode=OneWay}"
                        Style="{x:Bind helpers:Conversiones.EstiloConfianza(ViewModel.EstadoFecha.Confianza), Mode=OneWay}" />
                    <TextBlock x:Uid="FormularioRecibo_FechaLeida" VerticalAlignment="Center" Style="{StaticResource BodySmTextStyle}" />
                </StackPanel>
                <TextBlock
                    Style="{StaticResource BodySmTextStyle}"
                    Text="{x:Bind ViewModel.PeriodoLeidoTexto, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind helpers:Conversiones.VisibleSiHayTexto(ViewModel.PeriodoLeidoTexto), Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- Fase 9k (D9): lo demás que se leyó; todo se puede cambiar -->
        <StackPanel Spacing="{StaticResource Spacing16}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.Leido), Mode=OneWay}">
            <Grid ColumnSpacing="{StaticResource Spacing24}" RowSpacing="{StaticResource Spacing8}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <NumberBox
                    x:Uid="FormularioRecibo_Consumo"
                    Style="{StaticResource NumberBoxStyle}"
                    Value="{x:Bind ViewModel.ConsumoKwh, Mode=TwoWay}" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="{StaticResource Spacing8}"
                    Visibility="{x:Bind helpers:Conversiones.VisibleSiHayTexto(ViewModel.TarifaLeidaTexto), Mode=OneWay}">
                    <ContentPresenter
                        VerticalAlignment="Center"
                        Content="{x:Bind ViewModel.EstadoTarifa.Texto, Mode=OneWay}"
                        Style="{x:Bind helpers:Conversiones.EstiloConfianza(ViewModel.EstadoTarifa.Confianza), Mode=OneWay}" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" Text="{x:Bind ViewModel.TarifaLeidaTexto, Mode=OneWay}" />
                </StackPanel>
                <ContentPresenter
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    Content="{x:Bind ViewModel.EstadoConsumo.Texto, Mode=OneWay}"
                    Style="{x:Bind helpers:Conversiones.EstiloConfianza(ViewModel.EstadoConsumo.Confianza), Mode=OneWay}" />
            </Grid>

            <!-- Tramos del recibo, en filas sobre el lienzo -->
            <StackPanel Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneTramos), Mode=OneWay}">
                <TextBlock x:Uid="FormularioRecibo_TramosTitulo" Style="{StaticResource CaptionTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Tramos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Style="{StaticResource HairlineRowStyle}">
                                <TextBlock Style="{StaticResource BodySmTextStyle}" Text="{x:Bind}" TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Avisos de coherencia -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Avisos}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneAvisos), Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Style="{StaticResource HairlineRowStyle}">
                            <Grid ColumnSpacing="{StaticResource Spacing16}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Uid="FormularioRecibo_EtiquetaAviso" VerticalAlignment="Center" Style="{StaticResource YellowTagStyle}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodySmTextStyle}"
                                    Text="{x:Bind}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Contra la tarifa guardada del lugar (D8): solo informa -->
            <StackPanel Spacing="{StaticResource Spacing8}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneComparacion), Mode=OneWay}">
                <TextBlock x:Uid="FormularioRecibo_ComparacionTitulo" Style="{StaticResource CaptionTextStyle}" />
                <Border Style="{StaticResource HairlineRowStyle}">
                    <Grid ColumnSpacing="{StaticResource Spacing16}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter
                            VerticalAlignment="Top"
                            Content="{x:Bind ViewModel.VeredictoTexto, Mode=OneWay}"
                            Style="{x:Bind helpers:Conversiones.EstiloVeredicto(ViewModel.Veredicto), Mode=OneWay}" />
                        <StackPanel Grid.Column="1" Spacing="{StaticResource Spacing8}">
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource BodyTextStyle}"
                                Text="{x:Bind ViewModel.ComparacionTexto, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource BodySmTextStyle}"
                                Text="{x:Bind ViewModel.ComparacionTemporada, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind helpers:Conversiones.VisibleSiHayTexto(ViewModel.ComparacionTemporada), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Primer recibo del lugar (Fase 9c, D3): cada cuánto llega; con recibos guardados ya no se pregunta -->
        <StackPanel Spacing="{StaticResource Spacing8}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.PreguntarPeriodicidad), Mode=OneWay}">
            <TextBlock x:Uid="FormularioRecibo_Periodicidad" Style="{StaticResource SubheadingTextStyle}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing24}">
                <RadioButton
                    x:Uid="FormularioRecibo_CadaDosMeses"
                    GroupName="PeriodicidadRecibo"
                    IsChecked="{x:Bind ViewModel.CadaDosMeses, Mode=TwoWay}" />
                <RadioButton
                    x:Uid="FormularioRecibo_CadaMes"
                    GroupName="PeriodicidadRecibo"
                    IsChecked="{x:Bind ViewModel.CadaMes, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>

        <!-- Error en filas destacadas; lo escrito no se pierde -->
        <Border Style="{StaticResource HairlineRowStyle}" Visibility="{x:Bind helpers:Conversiones.VisibleSiHayTexto(ViewModel.ErrorRecibo), Mode=OneWay}">
            <Grid ColumnSpacing="{StaticResource Spacing16}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Uid="TarifaEditor_EtiquetaRevisa" VerticalAlignment="Center" Style="{StaticResource RiskHighTagStyle}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource BodyTextStyle}"
                    Text="{x:Bind ViewModel.ErrorRecibo, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Línea honesta con su explicación; con el consumo del recibo no es aproximado (Fase 9k, D6) -->
        <StackPanel
            Orientation="Horizontal"
            Spacing="{StaticResource Spacing16}"
            Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.UsaConsumo), Mode=OneWay}">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource BodySmTextStyle}"
                Text="{x:Bind ViewModel.ConsumoLeidoTexto, Mode=OneWay}"
                TextWrapping="Wrap" />
            <local:TerminoAyuda VerticalAlignment="Center" Clave="Kwh" />
        </StackPanel>
        <StackPanel
            Orientation="Horizontal"
            Spacing="{StaticResource Spacing16}"
            Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.NoUsaConsumo), Mode=OneWay}">
            <TextBlock
                x:Uid="OnboardingRecibo_Aproximado"
                VerticalAlignment="Center"
                Foreground="{StaticResource SlateBrush}"
                Style="{StaticResource BodySmTextStyle}"
                TextWrapping="Wrap" />
            <local:TerminoAyuda VerticalAlignment="Center" Clave="ConsumoAproximado" />
        </StackPanel>
    </StackPanel>
</UserControl>
