<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="VoltiaMX.Views.ConfiguracionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:VoltiaMX.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource ContentMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="{StaticResource Spacing40}">
            <TextBlock
                x:Uid="Config_Titulo"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource DisplayTextStyle}" />

            <!-- Una fila por ajuste, separadas por línea; sin tarjetas -->
            <Border Style="{StaticResource HairlineListStyle}">
                <StackPanel>
                    <Border Style="{StaticResource HairlineRowStyle}">
                        <Grid ColumnSpacing="{StaticResource Spacing24}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource Spacing8}">
                                <TextBlock x:Name="TituloModo" x:Uid="Config_ModoTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                <TextBlock x:Uid="Config_ModoTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Uid="Config_ModoSwitch"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind TituloModo.Text}"
                                IsOn="{x:Bind ViewModel.ModoAvanzado, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <!-- Notificaciones de Windows con los avisos -->
                    <Border Style="{StaticResource HairlineRowStyle}">
                        <Grid ColumnSpacing="{StaticResource Spacing24}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource Spacing8}">
                                <TextBlock x:Name="TituloNotificaciones" x:Uid="Config_NotificacionesTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                <TextBlock
                                    x:Uid="Config_NotificacionesTexto"
                                    Foreground="{StaticResource SlateBrush}"
                                    Style="{StaticResource BodySmTextStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="Config_NotificacionesNoDisponibles"
                                    Style="{StaticResource BodySmTextStyle}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.NotificacionesNoDisponibles)}" />
                                <Button
                                    x:Uid="Config_NotificacionesPrueba"
                                    Command="{x:Bind ViewModel.EnviarPruebaCommand}"
                                    Style="{StaticResource TextLinkButtonSmStyle}"
                                    Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.NotificacionesDisponibles)}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Uid="Config_NotificacionesSwitch"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind TituloNotificaciones.Text}"
                                IsOn="{x:Bind ViewModel.NotificacionesActivas, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource HairlineRowStyle}">
                        <Grid ColumnSpacing="{StaticResource Spacing24}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource Spacing8}">
                                <TextBlock x:Uid="Config_OnboardingTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                <TextBlock x:Uid="Config_OnboardingTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" />
                            </StackPanel>
                            <Button
                                x:Uid="Config_OnboardingBoton"
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.RepetirOnboardingCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource HairlineRowStyle}">
                        <Grid ColumnSpacing="{StaticResource Spacing24}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource Spacing8}">
                                <TextBlock x:Uid="Config_DemoTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                <TextBlock x:Uid="Config_DemoTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="{StaticResource Spacing16}">
                                <Button x:Uid="Config_DemoCargar" Command="{x:Bind ViewModel.CargarDemoCommand}" Style="{StaticResource GhostButtonStyle}" />
                                <Button x:Uid="Config_DemoQuitar" Command="{x:Bind ViewModel.QuitarDemoCommand}" Style="{StaticResource GhostButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource HairlineRowStyle}">
                        <Grid ColumnSpacing="{StaticResource Spacing24}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource Spacing8}">
                                <TextBlock x:Uid="Config_TarifasTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                <TextBlock x:Uid="Config_TarifasTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" />
                            </StackPanel>
                            <Button
                                x:Uid="Config_TarifasBoton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.AbrirTarifasCommand}"
                                Style="{StaticResource TextLinkButtonStyle}" />
                        </Grid>
                    </Border>

                    <!-- Reportes y exportación (para todos los perfiles) -->
                    <Border Style="{StaticResource HairlineRowStyle}">
                        <Grid ColumnSpacing="{StaticResource Spacing24}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource Spacing8}">
                                <TextBlock x:Uid="Config_ReportesTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                <TextBlock x:Uid="Config_ReportesTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" />
                            </StackPanel>
                            <Button
                                x:Uid="Config_ReportesBoton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.AbrirReportesCommand}"
                                Style="{StaticResource TextLinkButtonStyle}" />
                        </Grid>
                    </Border>

                    <!-- Respaldo y restauración (para todos los perfiles) -->
                    <Border Style="{StaticResource HairlineRowStyle}">
                        <Grid ColumnSpacing="{StaticResource Spacing24}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource Spacing8}">
                                <TextBlock x:Uid="Config_RespaldoTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                <TextBlock x:Uid="Config_RespaldoTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" />
                            </StackPanel>
                            <Button
                                x:Uid="Config_RespaldoBoton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.AbrirRespaldoCommand}"
                                Style="{StaticResource TextLinkButtonStyle}" />
                        </Grid>
                    </Border>

                    <!-- Solo en compilaciones Debug -->
                    <Border Style="{StaticResource HairlineRowStyle}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.EsDebug)}">
                        <Grid ColumnSpacing="{StaticResource Spacing24}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource Spacing8}">
                                <TextBlock x:Uid="Config_GaleriaTitulo" Style="{StaticResource SubheadingTextStyle}" />
                                <TextBlock x:Uid="Config_GaleriaTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" />
                            </StackPanel>
                            <Button
                                x:Uid="Config_GaleriaBoton"
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.AbrirGaleriaCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        </Grid>
                    </Border>

                    <!-- Versión: siempre al final, también en Release -->
                    <Border Style="{StaticResource HairlineRowStyle}">
                        <TextBlock x:Uid="Config_Version" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
