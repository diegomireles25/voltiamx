<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="VoltiaMX.Views.Onboarding.UbicacionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:VoltiaMX.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource ScrollAccentPadding}" Spacing="{StaticResource Spacing40}">
            <StackPanel Spacing="{StaticResource Spacing16}">
                <TextBlock
                    x:Uid="Ubicacion_Titulo"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource HeadingLgTextStyle}" />
                <TextBlock
                    x:Uid="Ubicacion_Ayuda"
                    Foreground="{StaticResource SlateBrush}"
                    Style="{StaticResource BodyTextStyle}" />
            </StackPanel>

            <Grid ColumnSpacing="{StaticResource Spacing24}" RowSpacing="{StaticResource Spacing24}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ComboBox
                    x:Uid="Ubicacion_Estado"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Estados}"
                    SelectedItem="{x:Bind ViewModel.EstadoSeleccionado, Mode=TwoWay}"
                    Style="{StaticResource ComboBoxStyle}" />
                <TextBox
                    x:Uid="Ubicacion_Municipio"
                    Grid.Column="1"
                    Style="{StaticResource InputStyle}"
                    Text="{x:Bind ViewModel.Municipio, Mode=TwoWay}" />
                <TextBox
                    x:Uid="Ubicacion_NombreLugar"
                    Grid.Row="1"
                    Style="{StaticResource InputStyle}"
                    Text="{x:Bind ViewModel.NombreLugar, Mode=TwoWay}" />
                <ComboBox
                    x:Uid="Ubicacion_Tarifa"
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{x:Bind helpers:Conversiones.No(ViewModel.NoSeMiTarifa), Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.Tarifas}"
                    SelectedItem="{x:Bind ViewModel.TarifaSeleccionada, Mode=TwoWay}"
                    Style="{StaticResource ComboBoxStyle}" />
            </Grid>

            <StackPanel Spacing="{StaticResource Spacing8}">
                <CheckBox x:Uid="Ubicacion_NoSe" IsChecked="{x:Bind ViewModel.NoSeMiTarifa, Mode=TwoWay}" />
                <TextBlock
                    x:Uid="Ubicacion_NoSeAyuda"
                    Foreground="{StaticResource SlateBrush}"
                    Style="{StaticResource BodySmTextStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
