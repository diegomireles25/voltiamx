<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Tu recibo (Fase 9b): escribir cuánto pagaste o escanear el recibo (que solo prellena el total, la fecha de
    corte y la tarifa). Siempre se puede revisar y cambiar lo escrito. Desde la Fase 9c el formulario es el común
    (FormularioRecibo), el mismo de Inicio y Mis recibos.
-->
<Page
    x:Class="VoltiaMX.Views.Onboarding.ReciboPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VoltiaMX.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource ScrollAccentPadding}" Spacing="{StaticResource Spacing32}">
            <StackPanel Spacing="{StaticResource Spacing16}">
                <TextBlock
                    x:Uid="OnboardingRecibo_Titulo"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource HeadingLgTextStyle}" />
                <TextBlock
                    x:Uid="OnboardingRecibo_Ayuda"
                    Foreground="{StaticResource SlateBrush}"
                    Style="{StaticResource BodyTextStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <local:FormularioRecibo ViewModel="{x:Bind ViewModel.Recibo}" />

            <Button
                x:Uid="OnboardingRecibo_SinRecibo"
                Command="{x:Bind ViewModel.SinReciboCommand}"
                Style="{StaticResource TextLinkButtonStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
