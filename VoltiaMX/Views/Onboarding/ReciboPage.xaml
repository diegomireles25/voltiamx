<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="VoltiaMX.Views.Onboarding.ReciboPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:VoltiaMX.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource ScrollAccentPadding}" Spacing="{StaticResource Spacing40}">
            <StackPanel Spacing="{StaticResource Spacing16}">
                <TextBlock
                    x:Uid="Recibo_Titulo"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource HeadingLgTextStyle}" />
                <TextBlock
                    x:Uid="Recibo_Ayuda"
                    Foreground="{StaticResource SlateBrush}"
                    Style="{StaticResource BodyTextStyle}" />
            </StackPanel>

            <!-- Tres caminos; escanear llega en una fase posterior -->
            <Grid ColumnSpacing="{StaticResource Spacing24}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <RadioButton GroupName="CaminoRecibo" IsEnabled="False" Style="{StaticResource SeleccionUnicaCardStyle}" AutomationProperties.Name="{x:Bind TituloReciboEscanear.Text}">
                    <StackPanel Spacing="{StaticResource Spacing8}">
                        <TextBlock x:Name="TituloReciboEscanear" x:Uid="Recibo_Escanear_Titulo" Style="{StaticResource HeadingSmTextStyle}" />
                        <TextBlock x:Uid="Recibo_Escanear_Proximamente" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    Grid.Column="1"
                    GroupName="CaminoRecibo"
                    IsChecked="{x:Bind ViewModel.ReciboManual, Mode=TwoWay}"
                    Style="{StaticResource SeleccionUnicaCardStyle}" AutomationProperties.Name="{x:Bind TituloReciboManual.Text}">
                    <StackPanel Spacing="{StaticResource Spacing8}">
                        <TextBlock x:Name="TituloReciboManual" x:Uid="Recibo_Manual_Titulo" Style="{StaticResource HeadingSmTextStyle}" />
                        <TextBlock x:Uid="Recibo_Manual_Descripcion" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    Grid.Column="2"
                    GroupName="CaminoRecibo"
                    IsChecked="{x:Bind ViewModel.ReciboSaltar, Mode=TwoWay}"
                    Style="{StaticResource SeleccionUnicaCardStyle}" AutomationProperties.Name="{x:Bind TituloReciboSaltar.Text}">
                    <StackPanel Spacing="{StaticResource Spacing8}">
                        <TextBlock x:Name="TituloReciboSaltar" x:Uid="Recibo_Saltar_Titulo" Style="{StaticResource HeadingSmTextStyle}" />
                        <TextBlock x:Uid="Recibo_Saltar_Descripcion" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </RadioButton>
            </Grid>

            <!-- Captura manual -->
            <StackPanel Spacing="{StaticResource Spacing24}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.ReciboManual), Mode=OneWay}">
                <Grid ColumnSpacing="{StaticResource Spacing24}" RowSpacing="{StaticResource Spacing24}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CalendarDatePicker
                        x:Uid="Recibo_FechaCorte"
                        HorizontalAlignment="Stretch"
                        Date="{x:Bind ViewModel.FechaCorte, Mode=TwoWay}"
                        Style="{StaticResource DatePickerStyle}" />
                    <StackPanel Grid.Column="1" Spacing="{StaticResource Spacing8}">
                        <TextBlock x:Uid="Recibo_Periodicidad" Style="{StaticResource BodySmTextStyle}" />
                        <RadioButton x:Uid="Recibo_Bimestral" GroupName="PeriodicidadRecibo" IsChecked="{x:Bind ViewModel.ReciboBimestral, Mode=TwoWay}" />
                        <RadioButton x:Uid="Recibo_Mensual" GroupName="PeriodicidadRecibo" IsChecked="{x:Bind ViewModel.ReciboMensual, Mode=TwoWay}" />
                    </StackPanel>
                    <NumberBox
                        x:Uid="Recibo_Kwh"
                        Grid.Row="1"
                        Style="{StaticResource NumberBoxStyle}"
                        Value="{x:Bind ViewModel.KwhRecibo, Mode=TwoWay}" />
                    <NumberBox
                        x:Uid="Recibo_Monto"
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource NumberBoxStyle}"
                        Value="{x:Bind ViewModel.MontoRecibo, Mode=TwoWay}" />
                    <!-- Opcional: la "lectura actual" del recibo, con su línea de ayuda en Description -->
                    <NumberBox
                        x:Uid="Recibo_LecturaMedidor"
                        Grid.Row="2"
                        Style="{StaticResource NumberBoxStyle}"
                        Value="{x:Bind ViewModel.LecturaMedidorRecibo, Mode=TwoWay}" />
                </Grid>
                <TextBlock
                    x:Uid="Recibo_Incompleto"
                    Foreground="{StaticResource SlateBrush}"
                    Style="{StaticResource BodySmTextStyle}"
                    Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.ReciboIncompleto), Mode=OneWay}" />
            </StackPanel>

            <!-- Saltar: ofrecer datos de demo -->
            <StackPanel Spacing="{StaticResource Spacing8}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.ReciboSaltar), Mode=OneWay}">
                <CheckBox x:Uid="Recibo_CargarDemo" IsChecked="{x:Bind ViewModel.CargarDemo, Mode=TwoWay}" />
                <TextBlock
                    x:Uid="Recibo_CargarDemoAyuda"
                    Foreground="{StaticResource SlateBrush}"
                    Style="{StaticResource BodySmTextStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
