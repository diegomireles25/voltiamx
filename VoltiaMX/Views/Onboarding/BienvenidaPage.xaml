<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="VoltiaMX.Views.Onboarding.BienvenidaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Spacing40}">
        <TextBlock
            x:Uid="Bienvenida_Titulo"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource DisplayTextStyle}" />
        <TextBlock
            x:Uid="Bienvenida_Subtitulo"
            MaxWidth="{StaticResource TextMaxWidth}"
            HorizontalAlignment="Left"
            Foreground="{StaticResource SlateBrush}"
            Style="{StaticResource BodyTextStyle}" />
        <Button
            x:Uid="Bienvenida_Empezar"
            Command="{x:Bind ViewModel.SiguienteCommand}"
            Style="{StaticResource PrimaryButtonStyle}" />
    </StackPanel>
</Page>
