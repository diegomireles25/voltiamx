<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="VoltiaMX.Views.Onboarding.ObjetivoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource ScrollAccentPadding}" Spacing="{StaticResource Spacing40}">
            <StackPanel Spacing="{StaticResource Spacing16}">
                <TextBlock
                    x:Uid="Objetivo_Titulo"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource HeadingLgTextStyle}" />
                <TextBlock
                    x:Uid="Objetivo_Ayuda"
                    Foreground="{StaticResource SlateBrush}"
                    Style="{StaticResource BodyTextStyle}" />
            </StackPanel>

            <!-- Selección única -->
            <Grid ColumnSpacing="{StaticResource Spacing24}" RowSpacing="{StaticResource Spacing24}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <RadioButton GroupName="Objetivo" IsChecked="{x:Bind ViewModel.ObjetivoEntender, Mode=TwoWay}" Style="{StaticResource SeleccionUnicaCardStyle}" AutomationProperties.Name="{x:Bind TituloObjetivoEntenderRecibo.Text}">
                    <StackPanel Spacing="{StaticResource Spacing8}">
                        <TextBlock x:Name="TituloObjetivoEntenderRecibo" x:Uid="Objetivo_EntenderRecibo_Titulo" Style="{StaticResource HeadingSmTextStyle}" />
                        <TextBlock x:Uid="Objetivo_EntenderRecibo_Descripcion" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Grid.Column="1" GroupName="Objetivo" IsChecked="{x:Bind ViewModel.ObjetivoPagarMenos, Mode=TwoWay}" Style="{StaticResource SeleccionUnicaCardStyle}" AutomationProperties.Name="{x:Bind TituloObjetivoPagarMenos.Text}">
                    <StackPanel Spacing="{StaticResource Spacing8}">
                        <TextBlock x:Name="TituloObjetivoPagarMenos" x:Uid="Objetivo_PagarMenos_Titulo" Style="{StaticResource HeadingSmTextStyle}" />
                        <TextBlock x:Uid="Objetivo_PagarMenos_Descripcion" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Grid.Row="1" GroupName="Objetivo" IsChecked="{x:Bind ViewModel.ObjetivoPresupuesto, Mode=TwoWay}" Style="{StaticResource SeleccionUnicaCardStyle}" AutomationProperties.Name="{x:Bind TituloObjetivoNoPasarmeDePresupuesto.Text}">
                    <StackPanel Spacing="{StaticResource Spacing8}">
                        <TextBlock x:Name="TituloObjetivoNoPasarmeDePresupuesto" x:Uid="Objetivo_NoPasarmeDePresupuesto_Titulo" Style="{StaticResource HeadingSmTextStyle}" />
                        <TextBlock x:Uid="Objetivo_NoPasarmeDePresupuesto_Descripcion" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Grid.Row="1" Grid.Column="1" GroupName="Objetivo" IsChecked="{x:Bind ViewModel.ObjetivoInquilinos, Mode=TwoWay}" Style="{StaticResource SeleccionUnicaCardStyle}" AutomationProperties.Name="{x:Bind TituloObjetivoRepartirInquilinos.Text}">
                    <StackPanel Spacing="{StaticResource Spacing8}">
                        <TextBlock x:Name="TituloObjetivoRepartirInquilinos" x:Uid="Objetivo_RepartirInquilinos_Titulo" Style="{StaticResource HeadingSmTextStyle}" />
                        <TextBlock x:Uid="Objetivo_RepartirInquilinos_Descripcion" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </RadioButton>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
