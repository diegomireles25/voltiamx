<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="VoltiaMX.Views.Onboarding.PresupuestoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource ScrollAccentPadding}" MaxWidth="{StaticResource TextMaxWidth}" HorizontalAlignment="Left" Spacing="{StaticResource Spacing40}">
            <StackPanel Spacing="{StaticResource Spacing16}">
                <TextBlock
                    x:Uid="Presupuesto_Titulo"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource HeadingLgTextStyle}" />
                <TextBlock
                    x:Uid="Presupuesto_Ayuda"
                    Foreground="{StaticResource SlateBrush}"
                    Style="{StaticResource BodyTextStyle}" />
            </StackPanel>

            <NumberBox
                x:Uid="Presupuesto_Monto"
                Style="{StaticResource NumberBoxStyle}"
                Value="{x:Bind ViewModel.PresupuestoMax, Mode=TwoWay}" />

            <!-- Solo se guarda la preferencia: los avisos llegan en una fase posterior -->
            <StackPanel Spacing="{StaticResource Spacing8}">
                <ToggleSwitch x:Uid="Presupuesto_Avisos" IsOn="{x:Bind ViewModel.Notificaciones, Mode=TwoWay}" />
                <TextBlock
                    x:Uid="Presupuesto_AvisosNota"
                    Foreground="{StaticResource SlateBrush}"
                    Style="{StaticResource BodySmTextStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
