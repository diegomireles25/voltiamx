<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Simulador solar (Fase 9e): primero la respuesta en lenguaje común, en la única tarjeta ("Necesitarías unos N
    paneles"), y debajo, en filas con línea sobre el lienzo, el espacio que ocupan, lo que producirían, lo que
    ahorrarías y el efecto en la tarifa alta. Los supuestos van plegados en "Ajustar supuestos". Es una estimación;
    los avisos están siempre junto al resultado. Se abre desde Inicio ("¿Y con paneles solares?") o, con el modo
    avanzado, desde el módulo Solar.
-->
<Page
    x:Class="VoltiaMX.Views.SolarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:VoltiaMX.Helpers"
    xmlns:local="using:VoltiaMX.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer>
        <!-- Contenido centrado con ancho máximo (Styles/Controls.xaml, PageContentHostStyle) -->
        <helpers:PanelCentrado Style="{StaticResource PageContentHostStyle}">
            <StackPanel
                Padding="{StaticResource PagePadding}"
                Spacing="{StaticResource Spacing40}">

                <StackPanel Spacing="{StaticResource Spacing16}">
                    <Button
                        x:Uid="Solar_Volver"
                        Command="{x:Bind ViewModel.VolverCommand}"
                        Style="{StaticResource TextLinkButtonSmStyle}"
                        Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.DesdeInicio), Mode=OneWay}" />
                    <TextBlock
                        x:Uid="Solar_Titulo"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource HeadingLgTextStyle}" />
                    <local:AvisoDatosEjemplo Comando="{x:Bind ViewModel.IrAConfiguracionCommand}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.EsDemo), Mode=OneWay}" />
                    <local:AvisoPreciosDeEjemplo Comando="{x:Bind ViewModel.IrATarifasCommand}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.PreciosDeEjemplo), Mode=OneWay}" />
                    <!-- D2: el consumo de partida es el del lugar (APROXIMADO si sale de un recibo por monto) -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="{StaticResource Spacing16}"
                        Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.UsaConsumoDelLugar), Mode=OneWay}">
                        <TextBlock
                            x:Uid="Solar_ConsumoDelRecibo"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextStyle}"
                            TextWrapping="Wrap" />
                        <ContentPresenter
                            x:Uid="Solar_Aproximado"
                            VerticalAlignment="Center"
                            Style="{StaticResource MintTagStyle}"
                            Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.ConsumoAproximado), Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        x:Uid="Solar_SinConsumoMedido"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource BodyTextStyle}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.SinConsumoMedido), Mode=OneWay}" />
                </StackPanel>

                <!-- La respuesta (D3): la única tarjeta -->
                <StackPanel Spacing="{StaticResource Spacing24}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneResultado), Mode=OneWay}">
                    <ContentPresenter Style="{StaticResource InvertedCardStyle}">
                        <StackPanel Spacing="{StaticResource Spacing8}">
                            <TextBlock x:Uid="Solar_NecesitariasTitulo" Foreground="{StaticResource AshBrush}" Style="{StaticResource CaptionTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing16}">
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Style="{StaticResource DisplayTextStyle}"
                                    Text="{x:Bind ViewModel.PanelesTexto, Mode=OneWay}" />
                                <TextBlock x:Uid="Solar_PanelesPalabra" VerticalAlignment="Bottom" Style="{StaticResource HeadingLgTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </ContentPresenter>

                    <!-- Filas con línea sobre el lienzo (E6): el espacio primero -->
                    <Border Style="{StaticResource HairlineListStyle}">
                        <StackPanel>
                        <Border Style="{StaticResource HairlineRowStyle}">
                            <Grid ColumnSpacing="{StaticResource Spacing16}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing16}">
                                    <TextBlock x:Uid="Solar_FilaEspacio" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                                    <local:TerminoAyuda VerticalAlignment="Center" Clave="Espacio" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SubheadingTextStyle}" Text="{x:Bind ViewModel.EspacioTexto, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource HairlineRowStyle}">
                            <Grid ColumnSpacing="{StaticResource Spacing16}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing16}">
                                    <TextBlock x:Uid="Solar_FilaProduccion" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                                    <local:TerminoAyuda VerticalAlignment="Center" Clave="Kwh" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SubheadingTextStyle}" Text="{x:Bind ViewModel.ProduccionTexto, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource HairlineRowStyle}">
                            <Grid ColumnSpacing="{StaticResource Spacing16}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing16}">
                                    <TextBlock x:Uid="Solar_FilaCubre" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SubheadingTextStyle}" Text="{x:Bind ViewModel.CubreTexto, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource HairlineRowStyle}">
                            <Grid ColumnSpacing="{StaticResource Spacing16}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing16}">
                                    <TextBlock x:Uid="Solar_FilaSobra" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SubheadingTextStyle}" Text="{x:Bind ViewModel.SobraTexto, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource HairlineRowStyle}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneAhorro), Mode=OneWay}">
                            <Grid ColumnSpacing="{StaticResource Spacing16}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing16}">
                                    <TextBlock x:Uid="Solar_FilaAhorraMes" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                                    <ContentPresenter
                                        x:Uid="Solar_Aproximado"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource MintTagStyle}"
                                        Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.AhorroAproximado), Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SubheadingTextStyle}" Text="{x:Bind ViewModel.AhorroMesTexto, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource HairlineRowStyle}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneAhorro), Mode=OneWay}">
                            <Grid ColumnSpacing="{StaticResource Spacing16}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing16}">
                                    <TextBlock x:Uid="Solar_FilaAhorraAnio" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                                    <ContentPresenter
                                        x:Uid="Solar_Aproximado"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource MintTagStyle}"
                                        Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.AhorroAproximado), Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SubheadingTextStyle}" Text="{x:Bind ViewModel.AhorroAnioTexto, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource HairlineRowStyle}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneInversion), Mode=OneWay}">
                            <Grid ColumnSpacing="{StaticResource Spacing16}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing16}">
                                    <TextBlock x:Uid="Solar_FilaInversionTexto" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SubheadingTextStyle}" Text="{x:Bind ViewModel.InversionTexto, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource HairlineRowStyle}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneInversion), Mode=OneWay}">
                            <Grid ColumnSpacing="{StaticResource Spacing16}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing16}">
                                    <TextBlock x:Uid="Solar_FilaRecuperacionTexto" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SubheadingTextStyle}" Text="{x:Bind ViewModel.RecuperacionTexto, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Style="{StaticResource BodySmTextStyle}"
                        Text="{x:Bind ViewModel.SinPesosTexto, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind helpers:Conversiones.VisibleSiHayTexto(ViewModel.SinPesosTexto), Mode=OneWay}" />
                    <TextBlock
                        x:Uid="Solar_NotaExcedente"
                        Foreground="{StaticResource SlateBrush}"
                        Style="{StaticResource BodySmTextStyle}"
                        TextWrapping="Wrap" />

                    <!-- DAC antes y después (estimación), como hoy -->
                    <Border Style="{StaticResource HairlineRowStyle}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneDac), Mode=OneWay}">
                        <StackPanel Spacing="{StaticResource Spacing8}">
                            <TextBlock x:Uid="Simulador_DacTitulo" Foreground="{StaticResource SlateBrush}" Style="{StaticResource CaptionTextStyle}" />
                            <Grid ColumnSpacing="{StaticResource Spacing16}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Simulador_DacAntes" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                                <ContentPresenter
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="{x:Bind ViewModel.DacAntesEtiqueta, Mode=OneWay}"
                                    Style="{x:Bind helpers:Conversiones.EstiloDac(ViewModel.DacAntesNivel), Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextStyle}"
                                    Text="{x:Bind ViewModel.DacAntesTexto, Mode=OneWay}" />
                            </Grid>
                            <Grid ColumnSpacing="{StaticResource Spacing16}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="Solar_DacConPaneles" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                                <ContentPresenter
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="{x:Bind ViewModel.DacDespuesEtiqueta, Mode=OneWay}"
                                    Style="{x:Bind helpers:Conversiones.EstiloDac(ViewModel.DacDespuesNivel), Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextStyle}"
                                    Text="{x:Bind ViewModel.DacDespuesTexto, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Avisos (D6): siempre junto al resultado -->
                <StackPanel Spacing="{StaticResource Spacing8}">
                    <TextBlock x:Uid="Solar_AvisoEstimacionTexto" Style="{StaticResource BodySmTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="Solar_AvisoNoIncluyeTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="Solar_AvisoTechoTexto" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="Solar_SinSupuestos" Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Ajustar supuestos (D3): plegado si ya hay consumo -->
                <StackPanel Spacing="{StaticResource Spacing16}">
                    <Button
                        Command="{x:Bind ViewModel.AlternarSupuestosCommand}"
                        Content="{x:Bind ViewModel.TextoAjustar, Mode=OneWay}"
                        Style="{StaticResource TextLinkButtonStyle}" />
                    <StackPanel Spacing="{StaticResource Spacing16}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.MostrarSupuestos), Mode=OneWay}">
                        <TextBlock
                            x:Uid="Solar_SupuestosTitulo"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock
                            x:Uid="Solar_ValoresEjemplo"
                            Foreground="{StaticResource SlateBrush}"
                            Style="{StaticResource BodySmTextStyle}"
                            TextWrapping="Wrap" />
                        <Border Style="{StaticResource HairlineListStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource HairlineRowStyle}">
                                    <NumberBox x:Uid="Solar_Consumo" Style="{StaticResource NumberBoxStyle}" Value="{x:Bind ViewModel.Consumo, Mode=TwoWay}" />
                                </Border>
                                <Border Style="{StaticResource HairlineRowStyle}">
                                    <NumberBox x:Uid="Solar_Porcentaje" Style="{StaticResource NumberBoxStyle}" Value="{x:Bind ViewModel.Porcentaje, Mode=TwoWay}" />
                                </Border>
                                <Border Style="{StaticResource HairlineRowStyle}">
                                    <StackPanel Spacing="{StaticResource Spacing8}">
                                        <NumberBox x:Uid="Solar_Horas" Style="{StaticResource NumberBoxStyle}" Value="{x:Bind ViewModel.Horas, Mode=TwoWay}" />
                                        <local:TerminoAyuda Clave="HorasDeSol" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HairlineRowStyle}">
                                    <NumberBox x:Uid="Solar_Eficiencia" Style="{StaticResource NumberBoxStyle}" Value="{x:Bind ViewModel.Eficiencia, Mode=TwoWay}" />
                                </Border>
                                <Border Style="{StaticResource HairlineRowStyle}">
                                    <NumberBox x:Uid="Solar_WattsPanel" Style="{StaticResource NumberBoxStyle}" Value="{x:Bind ViewModel.WattsPanel, Mode=TwoWay}" />
                                </Border>
                                <Border Style="{StaticResource HairlineRowStyle}">
                                    <NumberBox x:Uid="Solar_SuperficiePanel" Style="{StaticResource NumberBoxStyle}" Value="{x:Bind ViewModel.SuperficiePanel, Mode=TwoWay}" />
                                </Border>
                                <Border Style="{StaticResource HairlineRowStyle}">
                                    <NumberBox x:Uid="Solar_EspacioPaso" Style="{StaticResource NumberBoxStyle}" Value="{x:Bind ViewModel.EspacioPaso, Mode=TwoWay}" />
                                </Border>
                                <Border Style="{StaticResource HairlineRowStyle}">
                                    <StackPanel Spacing="{StaticResource Spacing8}">
                                        <NumberBox x:Uid="Solar_Costo" Style="{StaticResource NumberBoxStyle}" Value="{x:Bind ViewModel.Costo, Mode=TwoWay}" />
                                        <local:TerminoAyuda Clave="Kwp" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HairlineRowStyle}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneResultado), Mode=OneWay}">
                                    <TextBlock Foreground="{StaticResource SlateBrush}" Style="{StaticResource BodySmTextStyle}" Text="{x:Bind ViewModel.PotenciaInstaladaTexto, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Errores de validación: filas destacadas -->
                    <Border Style="{StaticResource HairlineListStyle}" Visibility="{x:Bind helpers:Conversiones.VisibleSi(ViewModel.TieneErrores), Mode=OneWay}">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Errores}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Style="{StaticResource HairlineRowStyle}">
                                        <Grid ColumnSpacing="{StaticResource Spacing16}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter x:Uid="TarifaEditor_EtiquetaRevisa" VerticalAlignment="Center" Style="{StaticResource RiskHighTagStyle}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                AutomationProperties.LiveSetting="Assertive"
                                                Style="{StaticResource BodyTextStyle}"
                                                Text="{x:Bind}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>

                    <!-- Exportar -->
                    <StackPanel Spacing="{StaticResource Spacing16}">
                        <Grid ColumnSpacing="{StaticResource Spacing16}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Uid="Solar_Referencia"
                                MaxLength="40"
                                Style="{StaticResource InputStyle}"
                                Text="{x:Bind ViewModel.Referencia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                x:Uid="Solar_ExportarPdf"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.ExportarPdfCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        </Grid>
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource BodyTextStyle}"
                            Text="{x:Bind ViewModel.Aviso, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind helpers:Conversiones.VisibleSiHayTexto(ViewModel.Aviso), Mode=OneWay}" />
                        <Border Style="{StaticResource HairlineRowStyle}" Visibility="{x:Bind helpers:Conversiones.VisibleSiHayTexto(ViewModel.Error), Mode=OneWay}">
                            <Grid ColumnSpacing="{StaticResource Spacing16}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Uid="TarifaEditor_EtiquetaRevisa" VerticalAlignment="Center" Style="{StaticResource RiskHighTagStyle}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.LiveSetting="Assertive"
                                    Style="{StaticResource BodyTextStyle}"
                                    Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <!-- Solo en Debug: la página agrega aquí la carpeta de salida para pruebas automatizadas -->
                        <StackPanel x:Name="ZonaDepuracion" Spacing="{StaticResource Spacing8}" />
                    </StackPanel>
            </StackPanel>
        </helpers:PanelCentrado>
    </ScrollViewer>
</Page>
