<?xml version="1.0" encoding="UTF-8" ?>
<!--
    "¿Qué es esto?": un enlace de texto que abre un Flyout con la explicación de un término (Ayuda_{Clave} en
    Resources.resw). Se abre con clic, Enter o Espacio y se cierra con Esc o al tocar fuera. El lector de pantalla
    oye el término en el nombre del enlace y la explicación como su ayuda.
-->
<UserControl
    x:Class="VoltiaMX.Views.TerminoAyuda"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button x:Name="Enlace" Style="{StaticResource TextLinkButtonSmStyle}">
        <Button.Flyout>
            <Flyout FlyoutPresenterStyle="{StaticResource AyudaFlyoutPresenterStyle}">
                <TextBlock
                    x:Name="Explicacion"
                    MaxWidth="{StaticResource HeroTextMaxWidth}"
                    Style="{StaticResource BodyTextStyle}"
                    TextWrapping="Wrap" />
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
