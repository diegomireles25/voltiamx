<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Ventana principal. Cabecera como mockup-dashboard.html: marca a la izquierda, navegación en
    pastilla al centro (generada desde los módulos activos) y "Nueva lectura" a la derecha.
-->
<Window
    x:Class="VoltiaMX.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:VoltiaMX.ViewModels"
    mc:Ignorable="d">
    <!-- Los AdaptiveTrigger no se evalúan en la raíz de una Window: el contenido va en un UserControl -->
    <UserControl>
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <!--
                Menos de 1200 de ancho: solo el rayo de la marca y el botón más compacto. Las columnas siguen
                siendo *, Auto y *, así que la pastilla queda centrada en la ventana: el menú tiene siempre 4
                pestañas y caben desde 1100 (el ancho mínimo), sin menú "...". El relleno de los ítems no cambia:
                WinUI lo toma de un ThemeResource que no responde al ancho de la ventana.
            -->
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="AnchoVentana">
                    <VisualState x:Name="Ancha">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="{StaticResource BreakpointWide}" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="Angosta">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="Marca.Visibility" Value="Collapsed" />
                            <Setter Target="NuevaLectura.Padding" Value="{StaticResource PrimaryButtonCompactPadding}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Zona para arrastrar la ventana; los botones del sistema quedan a la derecha -->
            <Grid x:Name="BarraTitulo" Height="{StaticResource TitleBarHeight}" />

            <Grid
                Grid.Row="1"
                Padding="{StaticResource HeaderPadding}"
                ColumnSpacing="{StaticResource Spacing24}"
                Style="{StaticResource NavBarStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColumnaMarca" Width="*" />
                    <ColumnDefinition x:Name="ColumnaNavegacion" Width="Auto" />
                    <ColumnDefinition x:Name="ColumnaAccion" Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{StaticResource Spacing8}">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="{StaticResource BrandIconSize}"
                        Glyph="&#xE945;" />
                    <TextBlock
                        x:Name="Marca"
                        x:Uid="Shell_Marca"
                        VerticalAlignment="Center"
                        Style="{StaticResource BrandTextStyle}" />
                </StackPanel>

                <ContentPresenter Grid.Column="1" Style="{StaticResource NavPillContainerStyle}">
                    <NavigationView
                        x:Name="Navegacion"
                        x:Uid="Shell_Navegacion"
                        ItemInvoked="AlInvocarElemento"
                        MenuItemsSource="{x:Bind ViewModel.Elementos, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.Seleccionado, Mode=TwoWay}"
                        Style="{StaticResource NavPillStyle}">
                        <NavigationView.MenuItemTemplate>
                            <DataTemplate x:DataType="vm:ElementoNavegacion">
                                <NavigationViewItem Content="{x:Bind Titulo}" Style="{StaticResource NavPillItemStyle}" />
                            </DataTemplate>
                        </NavigationView.MenuItemTemplate>
                    </NavigationView>
                </ContentPresenter>

                <!-- Habilitado cuando el módulo Lecturas está activo -->
                <Button
                    x:Name="NuevaLectura"
                    x:Uid="Shell_NuevaLectura"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.NuevaLecturaCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>

            <Frame x:Name="Contenido" Grid.Row="2" />
        </Grid>
    </UserControl>
</Window>
